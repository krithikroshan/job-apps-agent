# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# Real environment variables always take precedence over this file.

# Postgres connection string (Supabase). Required for fetch/queue/stats/serve.
# Project Settings -> Database -> Connection string -> URI, in your Supabase
# project. Also set this as an environment variable in the Vercel project
# settings for deployments -- there, use the *transaction* pooler (port
# 6543): the session pooler (5432) allows only 15 clients across every
# instance. Keep 5432 here for the tests, whose per-test schemas rely on a
# session-level search_path.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase Auth (signup/login). Project Settings -> API, in the same
# Supabase project as DATABASE_URL. Also set both as environment variables
# in the Vercel project settings for deployments.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: this app's public address, where signup-confirmation emails send
# people back to (/login). Defaults to the address the signup came from.
# Either way, add <address>/login under Authentication -> URL Configuration ->
# Redirect URLs in Supabase, and set the Site URL there to the live site.
# APP_URL=https://job-apps-agent.vercel.app

# Job boards -- any one works on its own; a missing key skips that board.
REED_API_KEY=your_reed_api_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Jooble (https://jooble.org/api/about) and Careerjet (https://www.careerjet.co.uk/partners/api)
JOOBLE_API_KEY=
CAREERJET_API_KEY=
# Careerjet asks for the searcher's IP; this app can only send one for everyone.
# CAREERJET_USER_IP=203.0.113.10

# Company careers sites (the Companies page): most site checks one user may
# run per day. Each check reads one company's site.
# JOBS_AGENT_COMPANY_CHECKS_PER_DAY=60

# Encrypts the AI provider keys users save on the Settings page. Generate
# with `python -m jobs_agent gen-key`. Changing it makes stored keys
# unreadable (users re-enter them). Also set this on Vercel.
APP_ENCRYPTION_KEY=

# Optional server-side AI keys, used for anyone who hasn't added their own
# on the Settings page. Any one is enough for cover letters and the profile
# assistant; leave them blank to make every user bring their own.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: default models when a user hasn't picked one.
# JOBS_AGENT_GEMINI_MODEL=gemini-3.6-flash
# JOBS_AGENT_GEMINI_FAST_MODEL=gemini-flash-lite-latest   # for analysing postings

# Most AI calls one user may make per day on the server keys above (their own
# keys are never capped). Analysing a full queue takes about 25.
# JOBS_AGENT_SERVER_AI_DAILY_CALLS=100
# JOBS_AGENT_OPENROUTER_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free
